{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelDrainagePlatform",
  "version": "1.0.0",
  "identifier": "com.reaticle.tunneldrainageplatform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "隧道工程多维协同智能排水自适应平台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tunnel-backend-sidecar"
    ],
    "resources": [
      "binaries/tunnel-backend-sidecar.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
