# tunnel-drainage-platform/deploy/server/.env.example
# 生产环境配置参数模板

# 宿主对外暴露网络端口
HTTP_PORT=80
HTTPS_PORT=443

# 日志输出等级 (debug | info | warning | error)
LOG_LEVEL=info

# 数据库持久化路径 (容器内部路径)
DB_PATH=/app/data/tunnel_params.db

# 系统运行环境
APP_ENV=production

# =============================================================
# 阶段6：平台安全认证机制与运维级密码配置 (Docker Server 模式)
# =============================================================
# 平台操作员密码 (出厂默认: chongqing123456)
# 生产运维改密说明：修改此项后执行 `docker compose restart backend` 热重启容器生效 (<=15s)
PLATFORM_AUTH_PASSWORD=chongqing123456

# 会话令牌验签 HMAC-SHA256 密钥 (生产部署请生成高熵随机字符串)
PLATFORM_SECRET_KEY=cqu_tunnel_platform_secret_key_2026_authtoken_prod

# 运行模式标记 (服务器协作模式固定为 server)
PLATFORM_AUTH_MODE=server

# 平台安全认证守卫开关 (生产环境强制为 true)
PLATFORM_AUTH_ENABLED=true

# 会话令牌有效时长 (单位: 分钟，默认 120 分钟)
AUTH_TOKEN_EXPIRE_MINUTES=120
